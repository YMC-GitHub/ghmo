ARG MODEL_ID="microsoft/Florence-2-base"
ARG DEVICE="cpu"
ARG TORCH_DTYPE="float32"

FROM python:3.11-slim AS base

ARG MODEL_ID
ARG DEVICE
ARG TORCH_DTYPE

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

ENV PIP_ROOT_USER_ACTION=ignore

RUN pip install torch==2.4.0+cpu --index-url https://download.pytorch.org/whl/cpu
RUN pip install "numpy<2" transformers==4.44.0 pillow einops protobuf==3.20.3

COPY <<EOF /app/export.py
import torch
from transformers import AutoProcessor, Florence2ForConditionalGeneration

model_id = "${MODEL_ID}"
device = "${DEVICE}"
torch_dtype = torch.${TORCH_DTYPE}

# 加载模型
model = Florence2ForConditionalGeneration.from_pretrained(
    model_id,
    torch_dtype=torch_dtype,
    trust_remote_code=True
).to(device).eval()

processor = AutoProcessor.from_pretrained(model_id, trust_remote_code=True)

# 构造正确输入
prompt = "<CAPTION>"
dummy_img = torch.randn(1, 3, 768, 768).to(device)
inputs = processor(
    text=prompt,
    images=dummy_img,
    return_tensors="pt"
).to(device)

# 静态输入 + 正确结构（Florence2 必须这样导出）
input_ids = inputs["input_ids"]
attention_mask = inputs["attention_mask"]
pixel_values = inputs["pixel_values"]
pixel_mask = inputs["pixel_mask"]

# 导出
torch.onnx.export(
    model,
    args=(input_ids, attention_mask, pixel_values, pixel_mask),
    f="/app/model.onnx",
    opset_version=16,
    do_constant_folding=True,
    input_names=["input_ids", "attention_mask", "pixel_values", "pixel_mask"],
    output_names=["logits"],
    dynamic_axes={
        "input_ids": {0: "batch", 1: "seq_len"},
        "attention_mask": {0: "batch", 1: "seq_len"},
    }
)

print("✅ SUCCESS: /app/model.onnx")
EOF

RUN python /app/export.py

FROM scratch AS export
COPY --from=base /app/model.onnx model.onnx