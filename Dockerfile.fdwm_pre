# ==============================================
# 构建参数
# ==============================================
ARG MODEL_ID="microsoft/Florence-2-base"
ARG DEVICE="cpu"
ARG TORCH_DTYPE="float32"

# ==============================================
# 基础镜像
# ==============================================
FROM python:3.11-slim AS base

ARG MODEL_ID
ARG DEVICE
ARG TORCH_DTYPE

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

ENV PIP_ROOT_USER_ACTION=ignore

# 安装固定版本组合（唯一无冲突组合）
# RUN pip install torch==2.5.0+cpu --index-url https://download.pytorch.org/whl/cpu
# RUN pip install "numpy<2" transformers==4.48.0 pillow einops protobuf==3.20.3 torchvision

RUN pip install torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip install "numpy<2" transformers>=4.49.0 pillow einops protobuf==3.20.3


# 导出脚本（已完全修复）
COPY <<EOF /app/export.py
import os
import torch
from transformers import AutoProcessor, Florence2ForConditionalGeneration

model_id = "${MODEL_ID}"
device = "${DEVICE}"
torch_dtype = torch.${TORCH_DTYPE}

# ✅ 修复：强制指定 revision 解决 bos token 配置报错
model = Florence2ForConditionalGeneration.from_pretrained(
    model_id,
    revision="refs/pr/13",
    torch_dtype=torch_dtype,
    trust_remote_code=True
).to(device).eval()

processor = AutoProcessor.from_pretrained(
    model_id,
    revision="refs/pr/13",
    trust_remote_code=True
)

# ✅ 正确输入
prompt = "<CAPTION>"
dummy_img = torch.randn(1, 3, 768, 768)
inputs = processor(
    text=prompt,
    images=dummy_img,
    return_tensors="pt"
).to(device)

# ✅ 正确导出
torch.onnx.export(
    model,
    (
        inputs["input_ids"],
        inputs["attention_mask"],
        inputs["pixel_values"],
        inputs["pixel_mask"]
    ),
    "/app/model.onnx",
    opset_version=16,
    do_constant_folding=True
)

print("✅ SUCCESS: /app/model.onnx")
EOF

RUN python /app/export.py

# ==============================================
# 输出模型
# ==============================================
FROM scratch AS export
COPY --from=base /app/model.onnx model.onnx