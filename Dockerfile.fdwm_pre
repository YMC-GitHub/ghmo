# ==============================================
# 构建参数
# ==============================================
ARG MODEL_ID="microsoft/Florence-2-base"
ARG DEVICE="cpu"
ARG TORCH_DTYPE="float32"

# ==============================================
# 基础镜像
# ==============================================
FROM python:3.11-slim AS base

ARG MODEL_ID
ARG DEVICE
ARG TORCH_DTYPE

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

ENV PIP_ROOT_USER_ACTION=ignore

# 安装依赖
RUN pip install torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip install "numpy<2" transformers>=4.49.0 pillow einops protobuf==3.20.3

# 导出脚本（修复无效revision问题）
COPY <<EOF /app/export.py
import os
import torch
from transformers import AutoProcessor, Florence2ForConditionalGeneration

model_id = "${MODEL_ID}"
device = "${DEVICE}"
torch_dtype = torch.${TORCH_DTYPE}

# 修复：移除无效的 revision=refs/pr/13 参数
model = Florence2ForConditionalGeneration.from_pretrained(
    model_id,
    torch_dtype=torch_dtype,
    trust_remote_code=True
).to(device).eval()

processor = AutoProcessor.from_pretrained(
    model_id,
    trust_remote_code=True
)

prompt = "<CAPTION>"
dummy_img = torch.randn(1, 3, 768, 768)
inputs = processor(
    text=prompt,
    images=dummy_img,
    return_tensors="pt"
).to(device)

# 导出ONNX
torch.onnx.export(
    model,
    (
        inputs["input_ids"],
        inputs["attention_mask"],
        inputs["pixel_values"],
        inputs["pixel_mask"]
    ),
    "/app/model.onnx",
    opset_version=16,
    do_constant_folding=True
)

print("✅ SUCCESS: /app/model.onnx")
EOF

RUN python /app/export.py

# ==============================================
# 输出模型
# ==============================================
FROM scratch AS export
COPY --from=base /app/model.onnx model.onnx